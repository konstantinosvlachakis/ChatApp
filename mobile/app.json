{
  "expo": {
    "name": "LangVoyage",
    "slug": "langvoyage-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      },
      "bundleIdentifier": "com.anonymous.langvoyagemobile"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1c2b"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.langvoyagemobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LangVoyage to access your photos so you can upload profile pictures.",
          "cameraPermission": false
        }
      ],
      "expo-speech-recognition",
      "expo-font",
      "expo-secure-store",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0d1c2b",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0d1c2b"
          }
        }
      ]
    ]
  }
}
