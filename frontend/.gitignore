.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs
.idea/        # JetBrains IDEs
.vscode/      # Visual Studio Code

# temporary files
*.tmp
*.temp
!docs/screenshots/*.png

# logs from npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
